rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya pengguna yang sudah masuk (anonim) yang boleh mengakses, dan hanya di dalam ruang yang kodenya mereka tahu.
    match /rooms/{room}/{document=**} {
      allow read, write: if request.auth != null && room.size() >= 12;
    }
  }
}
